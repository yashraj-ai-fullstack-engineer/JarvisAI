Username="yashraj"
Assistantname="NEXA"

# Deployment. Set APP_BASE_URL to the public backend URL after deployment.
# If serving the built React app from FastAPI, CORS can stay on the local dev
# defaults. If the frontend is hosted separately, add its public origin here.
APP_BASE_URL="http://localhost:8000"
FRONTEND_BASE_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
VITE_API_URL=""
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"

# MongoDB Atlas persistence. Replace both placeholders with your Atlas user.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.lc8wlaf.mongodb.net/?appName=Cluster0"
MONGODB_DATABASE="nexa"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"

# Google account sign-in (separate from the optional Gmail/Calendar/Drive connections below).
GOOGLE_SIGNIN_CLIENT_ID=""
GOOGLE_SIGNIN_CLIENT_SECRET=""
GOOGLE_SIGNIN_REDIRECT_URI=""

# LLM provider. Use openrouter for cloud deployment, lmstudio for local-only,
# or openrouter_lmstudio when the deployment can also reach your local server.
LLM_PROVIDER="lmstudio"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
OPENROUTER_FALLBACK_MODEL="poolside/laguna-s-2.1:free"
OPENROUTER_API_KEY=""
OPENROUTER_TIMEOUT_SECONDS="120"
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="NEXA"

# LangSmith observability. Traces are enabled only when both this flag and a
# LangSmith API key are present. Inputs and outputs stay hidden because Nexa
# can process private connected-app data. Root trace metadata includes the
# original user query and signed-in user email for trace identification.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="nexa"
LANGSMITH_WORKSPACE_ID=""
LANGSMITH_ENDPOINT=""
LANGSMITH_HIDE_INPUTS="true"
LANGSMITH_HIDE_OUTPUTS="true"

# LM Studio's OpenAI-compatible server. This must stay on this computer.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LMSTUDIO_REST_BASE_URL="http://127.0.0.1:1234/api/v1"
LMSTUDIO_MODEL="qwen3.5-2b"
LMSTUDIO_TIMEOUT_SECONDS="120"
LMSTUDIO_MAX_TOKENS="768"
LMSTUDIO_REASONING="off"

# /research only: a larger bounded completion for a sourced analytical report.
# Normal chat continues to use LMSTUDIO_MAX_TOKENS. Valid range: 768–4096.
RESEARCH_SYNTHESIS_MAX_OUTPUT_TOKENS="2200"

# Legacy local owner-resume index. Production uses the dedicated Supabase
# owner-profile store below and OpenRouter's PDF embedding configuration.
# Enable this only when developing with a local embedding server.
EMBEDDING_BASE_URL="http://127.0.0.1:1234/v1"
EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"
EMBEDDING_API_KEY="lm-studio"
EMBEDDING_TIMEOUT_SECONDS="60"
EMBEDDING_ALLOW_REMOTE="false"
OWNER_PROFILE_KEY="nexa_owner"
OWNER_PROFILE_SUBJECT="Yashraj Gupta"
OWNER_PROFILE_LOCAL_EMBEDDINGS="false"

# Uploaded PDF Q&A. Run supabase_pdf_rag.sql in your Supabase project first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
# Local image generation through AUTOMATIC1111 Stable Diffusion WebUI.
SD_WEBUI_BASE_URL="http://127.0.0.1:7860"
SD_IMAGE_WIDTH="512"
SD_IMAGE_HEIGHT="512"
SD_STEPS="15"
SD_CFG_SCALE="7"
SD_BATCH_SIZE="1"

# Local Vosk speech recognition.
INPUT_LANGUAGE="en"
VOSK_MODEL_PATH="models/vosk-model-small-en-us-0.15"
VOSK_SAMPLE_RATE="16000"
VOSK_LISTEN_SECONDS="12"
VOSK_INPUT_DEVICE=""
VOSK_PAUSE_SECONDS="1.0"

# Windows local SAPI text-to-speech.
LOCAL_TTS_RATE="185"
LOCAL_TTS_VOLUME="1.0"
LOCAL_FEMALE_VOICE_HINTS="zira,hazel,heera,female"
THINKING_SUMMARY_ENABLED="true"

# Google OAuth. Create an OAuth web client in Google Cloud, then
# add its credentials here. Gmail sending uses this connected account after UI
# confirmation; no Gmail password or app password is used. Drive is read-only.
# Tokens are encrypted locally with the Fernet key.
NEXA_MCP_CONFIG_PATH=".mcp.json"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_OAUTH_COOKIE_SECURE="false"
GOOGLE_OAUTH_COOKIE_SAMESITE="lax"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Geoapify places, geocoding, and directions. Create a key at geoapify.com,
# then restart Nexa. This key stays in the backend and is never sent to the UI.
GEOAPIFY_API_KEY=""

# Financial market research. /research stock and market-performance requests
# require this server-side key; Nexa deliberately never ranks stocks from a
# general web search. FMP supports the bounded exchange-quote snapshot used by
# the financial_market_data research source.
FMP_API_KEY=""

# Optional GitHub token for higher GitHub API quota. Public repository
# research works without it, but set a least-privilege token if several users
# will run GitHub research concurrently. This value remains backend-only.
GITHUB_TOKEN=""

RESEARCH_PDF_FONT_PATH=""
RESEARCH_PDF_BOLD_FONT_PATH=""

# Optional fallback country used for holiday-aware scheduling (ISO alpha-2, e.g. IN).
# When blank, Nexa uses the signed-in browser location if Geoapify is configured,
# otherwise it asks the user which country should be used.
NEXA_DEFAULT_COUNTRY_CODE="IN"
